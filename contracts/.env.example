# Clave privada de la wallet que despliega (será admin y oráculo). Usa una wallet SOLO de pruebas.
PRIVATE_KEY=0x...
# Opcional: otra dirección para el oráculo automático (por defecto, el desplegador)
# ORACLE_ADDRESS=0x...
# Tu wallet de MetaMask: queda como admin y oráculo, y recibe 500 tUSDC
OWNER_ADDRESS=0x...
# true = compra a cualquier hora y carencia de 60 s (para la demo)
DEMO_MODE=true
INITIAL_LIQUIDITY=2000
